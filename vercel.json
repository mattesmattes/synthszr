{
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/scheduled-tasks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/precompute-metrics",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/glossary-news",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/glossary-review",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/glossary-jobs",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron/glossary-translations",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
